{
  "schema_version": "1.0",
  "document_type": "network_requirement_item_definition",
  "description": "NW要件の共通項目、型、入力制約、成果物への連携先を定義する。",
  "status_values": [
    "draft",
    "under_review",
    "approved",
    "superseded"
  ],
  "data_types": {
    "string": "文字列",
    "integer": "整数",
    "number": "数値",
    "boolean": "true/false/null",
    "date": "YYYY-MM-DD",
    "array": "配列",
    "object": "オブジェクト"
  },
  "items": [
    {
      "id": "FIELD-001",
      "path": "metadata.project_name",
      "name": "案件名",
      "category": "案件基本",
      "type": "string",
      "required": true,
      "min_length": 1,
      "source": "利用者入力",
      "downstream": [
        "基本設計書",
        "詳細設計書",
        "全成果物表紙"
      ],
      "legacy_id": "REQ-001"
    },
    {
      "id": "FIELD-002",
      "path": "metadata.customer_name",
      "name": "顧客・組織名",
      "category": "案件基本",
      "type": "string",
      "required": true,
      "source": "利用者入力",
      "downstream": [
        "全成果物表紙"
      ],
      "legacy_id": "REQ-002"
    },
    {
      "id": "FIELD-003",
      "path": "scope.network_domains",
      "name": "対象ネットワーク領域",
      "category": "スコープ",
      "type": "array",
      "required": true,
      "allowed": [
        "LAN",
        "WAN",
        "Internet",
        "Security",
        "Wireless",
        "Cloud",
        "DC"
      ],
      "downstream": [
        "基本設計書",
        "WBS"
      ],
      "legacy_id": "REQ-003"
    },
    {
      "id": "FIELD-004",
      "path": "sites",
      "name": "拠点情報",
      "category": "拠点",
      "type": "array",
      "required": true,
      "min_items": 1,
      "key": "site_id",
      "downstream": [
        "構成図",
        "回線・拠点機器一覧",
        "IPアドレス管理表"
      ],
      "legacy_id": "REQ-004"
    },
    {
      "id": "FIELD-005",
      "path": "communications",
      "name": "通信要件",
      "category": "通信",
      "type": "array",
      "required": true,
      "min_items": 1,
      "key": "communication_id",
      "downstream": [
        "通信要件一覧",
        "アクセス制御一覧",
        "Firewall Config",
        "試験仕様書"
      ],
      "legacy_id": "REQ-005"
    },
    {
      "id": "FIELD-006",
      "path": "availability.target_sla_percent",
      "name": "目標可用性",
      "category": "可用性",
      "type": "number",
      "required": true,
      "max": 100,
      "unit": "%",
      "downstream": [
        "基本設計書",
        "冗長化設計",
        "試験仕様書"
      ],
      "legacy_id": "REQ-006",
      "exclusive_minimum": 0
    },
    {
      "id": "FIELD-007",
      "path": "addressing.private_address_policy",
      "name": "IPアドレス方針",
      "category": "アドレス",
      "type": "string",
      "required": true,
      "downstream": [
        "IPアドレス管理表",
        "構成図",
        "Config"
      ],
      "legacy_id": "REQ-007"
    },
    {
      "id": "FIELD-008",
      "path": "segmentation.required_segments",
      "name": "セグメント要件",
      "category": "VLAN/VRF",
      "type": "array",
      "required": true,
      "min_items": 1,
      "downstream": [
        "詳細設計書",
        "IPアドレス管理表",
        "Config"
      ],
      "legacy_id": "REQ-008"
    },
    {
      "id": "FIELD-009",
      "path": "routing.protocols",
      "name": "ルーティング方式",
      "category": "Routing",
      "type": "array",
      "required": true,
      "allowed": [
        "static",
        "OSPF",
        "BGP",
        "RIP",
        "IS-IS",
        "other"
      ],
      "downstream": [
        "詳細設計書",
        "構成図",
        "Config",
        "試験仕様書"
      ],
      "legacy_id": "REQ-009"
    },
    {
      "id": "FIELD-010",
      "path": "security.policy_model",
      "name": "通信制御モデル",
      "category": "Security",
      "type": "string",
      "required": true,
      "allowed": [
        "allowlist",
        "denylist",
        "hybrid"
      ],
      "downstream": [
        "通信要件一覧",
        "アクセス制御一覧",
        "Config"
      ],
      "legacy_id": "REQ-010"
    },
    {
      "id": "FIELD-011",
      "path": "operations.monitoring_required",
      "name": "監視要否",
      "category": "運用",
      "type": "boolean",
      "required": true,
      "downstream": [
        "運用設計書",
        "監視項目一覧",
        "Config"
      ],
      "legacy_id": "REQ-011"
    },
    {
      "id": "FIELD-012",
      "path": "operations.log_retention_days",
      "name": "ログ保存期間",
      "category": "運用",
      "type": "integer",
      "required_if": "operations.syslog_required == true",
      "min": 1,
      "unit": "日",
      "downstream": [
        "運用設計書"
      ],
      "legacy_id": "REQ-012"
    },
    {
      "id": "FIELD-013",
      "path": "migration.allowable_downtime_minutes",
      "name": "許容停止時間",
      "category": "移行",
      "type": "integer",
      "required_if": "migration.migration_required == true",
      "min": 0,
      "unit": "分",
      "downstream": [
        "移行計画書",
        "切替手順書"
      ],
      "legacy_id": "REQ-013"
    },
    {
      "id": "FIELD-014",
      "path": "platforms",
      "name": "採用機器・ソフトウェア",
      "category": "機器",
      "type": "array",
      "required_if": "scope.target_phase contains detailed_design",
      "key": "vendor+model+software_version",
      "downstream": [
        "機器一覧",
        "パラメータシート",
        "Config"
      ],
      "legacy_id": "REQ-014"
    },
    {
      "id": "FIELD-015",
      "path": "deliverables_required",
      "name": "必要成果物",
      "category": "成果物",
      "type": "object",
      "required": true,
      "downstream": [
        "WBS",
        "成果物一覧"
      ],
      "legacy_id": "REQ-015"
    },
    {
      "id": "FIELD-016",
      "path": "open_issues",
      "name": "未決事項",
      "category": "品質",
      "type": "array",
      "required": true,
      "key": "issue_id",
      "downstream": [
        "課題管理表",
        "設計着手判定"
      ],
      "legacy_id": "REQ-016"
    }
  ],
  "id_policy": "FIELDは入力項目定義、Qはヒアリング質問、REQは案件要件。旧REQ番号はファイル別の対応表で解釈し、一律置換しない。",
  "maintenance": {
    "updated": "2026-10-01",
    "status": "draft",
    "change": "構文・参照・判定の修正。承認を意味しない。"
  }
}
